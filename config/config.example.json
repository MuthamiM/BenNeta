{
    "imap": {
        "host": "mailserver.example.com",
        "port": 993,
        "ssl": true,
        "username": "user@example.com",
        "password": "YOUR_APP_PASSWORD_HERE",
        "folder": "INBOX",
        "search_criterion": "UNSEEN",
        "fetch_limit": 25
    },
    "notifications": {
        "desktop_alerts": true,
        "mode": "AUTO",
        "quiet_hours_enabled": true,
        "quiet_start": "22:00",
        "quiet_end": "08:00"
    },
    "rules": [
        {
            "id": 1,
            "name": "Critical Infrastructure Outage",
            "match_subject": [
                "outage",
                "server down",
                "critical alert",
                "failed"
            ],
            "match_sender": [
                "alert@",
                "monitoring@"
            ],
            "action": "auto_approve_and_notify",
            "target_priority": "HIGH",
            "command": ""
        },
        {
            "id": 2,
            "name": "Meetings and Calendar Invites",
            "match_subject": [
                "invitation:",
                "meeting",
                "zoom link",
                "schedule call"
            ],
            "match_sender": [],
            "action": "auto_approve",
            "target_priority": "MEDIUM",
            "command": ""
        }
    ],
    "daemon": {
        "poll_interval_seconds": 60,
        "sync_todo_txt": true,
        "todo_txt_path": "~/todo.txt"
    },
    "ai_model": {
        "provider": "brave",
        "name": "Brave AI Intelligence",
        "api_key": "YOUR_BRAVE_API_KEY_HERE",
        "default": true,
        "enabled": true
    },
    "brave_search": {
        "api_key": "YOUR_BRAVE_API_KEY_HERE",
        "enabled": true,
        "default": true
    },
    "watched_emails": {
        "senders": [],
        "keywords": [
            "urgent",
            "contract",
            "proposal",
            "invoice",
            "meeting",
            "api",
            "security"
        ]
    },
    "smtp": {
        "host": "mailserver.businessidentity.llc",
        "port": 465,
        "ssl": true,
        "sender": "info@mftechnologies.org",
        "password": "YOUR_SMTP_PASSWORD_HERE",
        "alert_to": "your-email@gmail.com"
    },
    "resend_api_key": "YOUR_RESEND_API_KEY_HERE"
}